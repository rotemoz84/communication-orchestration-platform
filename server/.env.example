# Communication Orchestration Platform - example environment
# Copy to .env and replace values. Do not commit real secrets.

# Runtime
NODE_ENV=development
PORT=3003
BASE_URL=http://localhost:3003
# Leave empty for root deployment, or set a prefix such as /clinic-api.
BASE_PATH=
# Set to 1 in production behind a trusted reverse proxy.
TRUST_PROXY=0
# In production this is automatic. Set to true in staging to fail startup when
# critical readiness checks fail.
REQUIRE_READY_ON_START=false
TIMEZONE=Asia/Jerusalem

# PostgreSQL database
DB_HOST=db.example.supabase.co
DB_PORT=6543
DB_USER=postgres.example
DB_PASSWORD=example-db-password-change-me
DB_NAME=postgres

# Google Sheets and Calendar
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
GOOGLE_CALENDAR_ID=clinic-calendar@example.com

# Admin site and session
# Use a long random value in real environments.
SESSION_SECRET=example-session-secret-change-me-64-characters-minimum
# Default session duration is 1 hour. SESSION_MAX_AGE_MS overrides hours when set.
SESSION_MAX_AGE_HOURS=1
SESSION_MAX_AGE_MS=3600000

# First admin user seed script
# Used by: npm run seed-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=example-admin-password-change-me

# Cron/session bootstrap for protected scheduled jobs
CRON_SECRET=example-cron-secret-change-me-64-characters-minimum
CRON_ADMIN_EMAIL=admin@example.com

# Business phone routing
REP_PHONE_NUMBER=+972501234567
# Public key from Telnyx Mission Control Portal: Keys & Credentials > Public Key
TELNYX_PUBLIC_KEY=example-telnyx-public-key-change-me

# IVR behavior
IVR_CALL_RECORDING=true
IVR_EMERGENCY_MODE=false
IVR_QUEUE_ENABLED=false
IVR_MAX_QUEUE_SIZE=10
IVR_CUSTOM_GREETING=Welcome to the clinic
IVR_CALL_FORWARDING=true

# SMTP email delivery
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_PASSWORD=example-smtp-password-change-me
EMAIL_FROM=notifications@example.com
EMAIL_NOTIFICATION_TO=clinic-office@example.com
# Comma- or semicolon-separated list that receives successful deployment confirmations.
DEPLOYMENT_SUCCESS_EMAIL_TO=owner@example.com,developer@example.com

# Temporary internal recipient for IVR fallback validation
IVR_FALLBACK_EMAIL_TO=ivr-validation@example.com
