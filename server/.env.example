# Google API Credentials
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Your Google Sheet ID
GOOGLE_SHEET_ID=your-google-sheet-id

# Your Google Calendar ID
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Server settings
PORT=3003
BASE_PATH=
BASE_URL=http://localhost:3003

# Production: use EXACT names (case-sensitive). Enables secure cookies and trust proxy.
# NODE_ENV=production
# TRUST_PROXY=1

# Admin site (session + first user). Must be SESSION_SECRET (all caps) or session won't work.
SESSION_SECRET=your-long-random-secret-at-least-32-chars
# Session duration: default 1 hour. Use SESSION_MAX_AGE_HOURS (e.g. 0.5 for 30 min, 2 for 2 h) or SESSION_MAX_AGE_MS.
# SESSION_MAX_AGE_HOURS=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# Cron job auth (for daily inquiry summary etc.). Cron calls POST /api/auth/cron-login then POST /api/inquiries/send-summary with the cookie.
CRON_SECRET=your-long-random-cron-secret
CRON_ADMIN_EMAIL=admin@example.com

# Your timezone (important for correct times!)
TIMEZONE=Asia/Jerusalem

# Telnyx TeXML inbound IVR is configured in the Telnyx portal using BASE_URL.
# Rep phone number where the inbound IVR dials during open hours.
REP_PHONE_NUMBER=+972500000000

# IVR Settings
IVR_CALL_RECORDING=true
IVR_EMERGENCY_MODE=false
IVR_QUEUE_ENABLED=false
IVR_MAX_QUEUE_SIZE=10
IVR_CUSTOM_GREETING=
IVR_CALL_FORWARDING=true

# PostgreSQL Database Configuration (Supabase Pooler)
DB_HOST=your-db-host.pooler.supabase.com
DB_PORT=6543
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=postgres

# Email Configuration (a2hosting SMTP)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=your-email@yourdomain.com
EMAIL_NOTIFICATION_TO=recipient@example.com
# Internal validation recipient for the temporary IVR fallback notification
IVR_FALLBACK_EMAIL_TO=ivr-validation@example.com
